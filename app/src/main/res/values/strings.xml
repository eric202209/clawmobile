    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_min_openclaw">Minimum supported OpenClaw Gateway: 2.13+</string>
    <string name="about_github">Open GitHub</string>
    <string name="about_section_guide">Quick guide</string>
    <string name="about_guide_setup_title">1. Connect the Gateway</string>
    <string name="about_guide_setup_body">Open Settings, enter the Gateway host, port, token, and HTTPS mode, then tap Test Gateway. Use a LAN IP or Tailscale IP from your phone, not localhost.</string>
    <string name="about_guide_chat_title">2. Start with chat</string>
    <string name="about_guide_chat_body">Return to Claw Mobile and send a short operational request. Useful examples: show blockers all, diagnose task &lt;task_id&gt;, resume session &lt;session_id&gt;, or summarize why project &lt;project_id&gt; is stuck.</string>
    <string name="about_guide_runs_title">3. Use Runs for supervision</string>
    <string name="about_guide_runs_body">Open Runs when you want to inspect tasks, sessions, checkpoints, and project progress. This is the mobile control surface for checking work while away from the host machine.</string>
    <string name="about_guide_notes_tools_title">4. Work offline when needed</string>
    <string name="about_guide_notes_tools_body">Use Notes for local scratchpad context and Tools for token estimates, prompt cleanup, JSON formatting, and YAML validation. These work without a running OpenClaw server.</string>
    <string name="about_section_compatibility">Compatibility</string>
    <string name="about_section_links">Links</string>

